# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.

# Endereço público do site (usado no sitemap e nas imagens de compartilhamento)
NEXT_PUBLIC_SITE_URL=https://seu-site.vercel.app
# Enquanto for surpresa, deixe false: o site pede para o Google não indexar.
NEXT_PUBLIC_ALLOW_INDEXING=false

# PostHog: rastreamento (chave pública do projeto, começa com phc_)
NEXT_PUBLIC_POSTHOG_KEY=
# "us" ou "eu", conforme a região escolhida ao criar a conta
NEXT_PUBLIC_POSTHOG_REGION=us

# PostHog: leitura dos dados no painel /admin (NUNCA use prefixo NEXT_PUBLIC_ aqui)
# Chave pessoal com permissão "Query: Read" e o ID numérico do projeto
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Painel /admin
ADMIN_PASSWORD=
# Gere com: openssl rand -base64 32
ADMIN_SESSION_SECRET=
